# =============================================================================
# MAISON — Variables de entorno
#
#   cp .env.example .env
#
# Rellená los valores marcados como REQUERIDO. Los secretos de pago, correo y
# almacenamiento los obtenés de los paneles de cada proveedor; no hay valores
# por defecto a propósito: si falta una variable requerida la app falla al
# arrancar en vez de connectar con una clave conocida.
#
# `.env` está en .gitignore. No lo commitees nunca.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (REQUERIDO)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=          # REQUERIDO. Contraseña de Postgres del stack local
DB_URL=jdbc:postgresql://localhost:5432/fashion_ecommerce
DB_USERNAME=postgres
DB_PASSWORD=                # REQUERIDO. misma que POSTGRES_PASSWORD
DB_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Cache y mensajería (REQUERIDO)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=             # REQUERIDO. La que definiste en REDIS_PASSWORD
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=          # REQUERIDO

# -----------------------------------------------------------------------------
# Seguridad / JWT (REQUERIDO)
# -----------------------------------------------------------------------------
# Generá una con:  openssl rand -base64 48
# Tiene que tener 32 bytes o más.
JWT_SECRET=                 # REQUERIDO. Si falta, la app no arranca.
JWT_ISSUER=fashion-ecommerce
JWT_AUDIENCE=fashion-ecommerce-api
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Bootstrap del admin. Si queda vacío, AdminPasswordResetRunner no hace nada.
# Si lo definís, codifica con BCrypt(12) y la aplica al arrancar.
# Cambiala después del primer login.
ADMIN_DEFAULT_PASSWORD=     # opcional, vacío por defecto

# -----------------------------------------------------------------------------
# CORS y servidor
# -----------------------------------------------------------------------------
SERVER_PORT=8080
MANAGEMENT_PORT=8081
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOADS_DIR=./uploads

# -----------------------------------------------------------------------------
# Pagos —Stripe (opcional: vacío = integración desactivada)
# -----------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pen
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel

# PayPal (opcional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=http://localhost:3000/checkout/paypal/success
PAYPAL_CANCEL_URL=http://localhost:3000/checkout/paypal/cancel

# -----------------------------------------------------------------------------
# Imágenes — Cloudinary (opcional: vacío = se guardan en disco local)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fashion-ecommerce

# -----------------------------------------------------------------------------
# Correo (opcional)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Reglas de negocio
# -----------------------------------------------------------------------------
SHIPPING_FREE_THRESHOLD=500.00
SHIPPING_STANDARD_COST=25.00
SHIPPING_EXPRESS_COST=25.00
SHIPPING_PICKUP_COST=0.00
LOYALTY_POINTS_PER_SOL=1
LOYALTY_POINTS_VALUE=0.10
LOYALTY_MIN_REDEMPTION=100
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
FEATURE_NEW_CHECKOUT_ENABLED=true
FEATURE_LOYALTY_PROGRAM_ENABLED=true
FEATURE_PREORDERS_ENABLED=false
FEATURE_BNPL_ENABLED=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=WARN
LOG_FILE_PATH=/var/log/fashion-ecommerce
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=30
MANAGEMENT_HEALTH_MAIL_ENABLED=false
MANAGEMENT_ENDPOINTS_HEALTH_SHOW_DETAILS=always